# Backend
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ALLOWED_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000
# Optional: only needed if switching from the included OSM basemap.
VITE_MAPTILER_KEY=
VITE_MAPBOX_TOKEN=
# Google Maps JavaScript API with the Maps 3D library. Restrict this browser key to
# localhost development and the deployed domain, and only the required Maps APIs.
VITE_GOOGLE_MAPS_API_KEY=
